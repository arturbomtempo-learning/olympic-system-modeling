@startuml

title Diagrama de Sequência - Sistema de Gestão Olímpica

actor Usuário
actor Administrador
actor Atleta

participant "Frontend Web" as Frontend
participant "API Gateway" as Gateway

participant "Serviço\nAutenticação" as AuthService
participant "Serviço\nCompetições" as CompetitionService
participant "Serviço\nInscrições" as RegistrationService
participant "Serviço\nResultados" as ResultService
participant "Serviço\nRelatórios" as ReportService
participant "Serviço\nLocais" as VenueService
participant "Serviço\nPaíses" as CountryService

queue "Fila Competições" as CompetitionQueue
queue "Fila Resultados" as ResultQueue
queue "Fila Notificações" as NotificationQueue

database "DB Usuários" as UserDB
database "DB Competições" as CompetitionDB
database "DB Inscrições" as RegistrationDB
database "DB Resultados" as ResultDB
database "DB Relatórios" as ReportDB
database "DB Locais" as VenueDB
database "DB Países" as CountryDB

participant "Email API" as EmailAPI
participant "WhatsApp API" as WhatsAppAPI

== 1. Autenticação ==

Usuário -> Frontend : login(email, senha)
activate Frontend

Frontend -> Gateway : autenticar(email, senha)
activate Gateway

Gateway -> AuthService : validarCredenciais(email, senha)
activate AuthService

AuthService -> UserDB : buscarUsuario(email)
activate UserDB

UserDB --> AuthService : dadosUsuario
deactivate UserDB

alt Credenciais inválidas

    AuthService --> Gateway : erroAutenticacao()

    Gateway --> Frontend : erroLogin()

    Frontend --> Usuário : exibirErro()

else Credenciais válidas

    AuthService --> Gateway : tokenAcesso(jwt)

    Gateway --> Frontend : loginRealizado(token)

    Frontend --> Usuário : acessoLiberado()

end

deactivate AuthService
deactivate Gateway
deactivate Frontend

== 2. Cadastro de Atleta ==

Administrador -> Frontend : cadastrarAtleta(dadosAtleta)
activate Frontend

Frontend -> Gateway : cadastrarAtleta(dadosAtleta)
activate Gateway

Gateway -> AuthService : validarAdministrador()
activate AuthService

AuthService -> UserDB : verificarEmail(email)
activate UserDB

UserDB --> AuthService : resultado
deactivate UserDB

alt Email já cadastrado

    AuthService --> Gateway : erroEmailDuplicado()

    Gateway --> Frontend : cadastroNegado()

else Email disponível

    AuthService -> CountryService : validarPais(sigla)
    activate CountryService

    CountryService -> CountryDB : buscarPais(sigla)
    activate CountryDB

    CountryDB --> CountryService : dadosPais
    deactivate CountryDB

    CountryService --> AuthService : paisValido()
    deactivate CountryService

    AuthService -> UserDB : salvarAtleta(dadosAtleta)
    activate UserDB

    UserDB --> AuthService : atletaID
    deactivate UserDB

    AuthService --> Gateway : atletaCadastrado(atletaID)

    Gateway --> Frontend : cadastroRealizado()

end

Frontend --> Administrador : confirmaçãoCadastro()

deactivate AuthService
deactivate Gateway
deactivate Frontend

== 3. Cadastro de Competição ==

Administrador -> Frontend : cadastrarCompeticao(dados)
activate Frontend

Frontend -> Gateway : criarCompeticao(dados)
activate Gateway

Gateway -> CompetitionService : criarCompeticao(dados)
activate CompetitionService

CompetitionService -> VenueService : verificarDisponibilidade(local,data)
activate VenueService

VenueService -> VenueDB : consultarDisponibilidade(local)
activate VenueDB

VenueDB --> VenueService : disponibilidade
deactivate VenueDB

VenueService --> CompetitionService : statusLocal
deactivate VenueService

alt Local indisponível

    CompetitionService --> Gateway : erroLocalIndisponivel()

    Gateway --> Frontend : operaçãoNegada()

else Local disponível

    CompetitionService -> CompetitionDB : salvarCompeticao(dados)
    activate CompetitionDB

    CompetitionDB --> CompetitionService : competicaoID
    deactivate CompetitionDB

    CompetitionService -> CompetitionQueue : publicarCompeticaoCriada()

    CompetitionService --> Gateway : competicaoCriada()

    Gateway --> Frontend : cadastroRealizado()

end

Frontend --> Administrador : confirmaçãoCompeticao()

deactivate CompetitionService
deactivate Gateway
deactivate Frontend

== 4. Inscrição em Competição ==

Atleta -> Frontend : inscreverCompeticao(atletaID, competicaoID)
activate Frontend

Frontend -> Gateway : realizarInscricao()
activate Gateway

Gateway -> RegistrationService : realizarInscricao()
activate RegistrationService

RegistrationService -> AuthService : validarAtleta(atletaID)
activate AuthService

AuthService -> UserDB : buscarAtleta(atletaID)
activate UserDB

UserDB --> AuthService : dadosAtleta
deactivate UserDB

AuthService --> RegistrationService : atletaValido()
deactivate AuthService

RegistrationService -> CompetitionService : validarCompeticao(competicaoID)
activate CompetitionService

CompetitionService -> CompetitionDB : buscarCompeticao()
activate CompetitionDB

CompetitionDB --> CompetitionService : dadosCompeticao
deactivate CompetitionDB

CompetitionService --> RegistrationService : competicaoValida()
deactivate CompetitionService

RegistrationService -> RegistrationDB : verificarInscricao()
activate RegistrationDB

RegistrationDB --> RegistrationService : resultado
deactivate RegistrationDB

alt Inscrição duplicada

    RegistrationService --> Gateway : erroInscricaoDuplicada()

    Gateway --> Frontend : inscriçãoNegada()

else Inscrição válida

    RegistrationService -> RegistrationDB : salvarInscricao()
    activate RegistrationDB

    RegistrationDB --> RegistrationService : inscricaoID
    deactivate RegistrationDB

    RegistrationService -> NotificationQueue : publicarEventoInscricao()

    NotificationQueue -> EmailAPI : enviarEmailConfirmacao()
    activate EmailAPI

    EmailAPI --> NotificationQueue : emailEnviado()
    deactivate EmailAPI

    NotificationQueue -> WhatsAppAPI : enviarMensagemConfirmacao()
    activate WhatsAppAPI

    WhatsAppAPI --> NotificationQueue : mensagemEnviada()
    deactivate WhatsAppAPI

    RegistrationService --> Gateway : inscricaoConfirmada()

    Gateway --> Frontend : inscriçãoRealizada()

end

Frontend --> Atleta : confirmaçãoInscrição()

deactivate RegistrationService
deactivate Gateway
deactivate Frontend

== 5. Cancelamento de Inscrição ==

Atleta -> Frontend : cancelarInscricao(inscricaoID)
activate Frontend

Frontend -> Gateway : cancelarInscricao()
activate Gateway

Gateway -> RegistrationService : cancelarInscricao()
activate RegistrationService

RegistrationService -> RegistrationDB : buscarInscricao()
activate RegistrationDB

RegistrationDB --> RegistrationService : dadosInscricao
deactivate RegistrationDB

alt Competição iniciada

    RegistrationService --> Gateway : cancelamentoNaoPermitido()

    Gateway --> Frontend : operaçãoNegada()

else Cancelamento permitido

    RegistrationService -> RegistrationDB : atualizarStatus(CANCELADA)
    activate RegistrationDB

    RegistrationDB --> RegistrationService : inscriçãoCancelada()
    deactivate RegistrationDB

    RegistrationService --> Gateway : cancelamentoRealizado()

    Gateway --> Frontend : cancelamentoConfirmado()

end

Frontend --> Atleta : confirmaçãoCancelamento()

deactivate RegistrationService
deactivate Gateway
deactivate Frontend

== 6. Registro de Resultados ==

Administrador -> Frontend : registrarResultado(classificacao)
activate Frontend

Frontend -> Gateway : registrarResultado()
activate Gateway

Gateway -> ResultService : registrarResultado()
activate ResultService

ResultService -> CompetitionService : validarCompeticao()
activate CompetitionService

CompetitionService -> CompetitionDB : buscarCompeticao()
activate CompetitionDB

CompetitionDB --> CompetitionService : dadosCompeticao
deactivate CompetitionDB

CompetitionService --> ResultService : competicaoValida()
deactivate CompetitionService

ResultService -> ResultDB : salvarResultado()
activate ResultDB

ResultDB --> ResultService : resultadoID
deactivate ResultDB

ResultService -> ResultQueue : publicarResultado()

par Atualizar Relatórios

    ResultQueue -> ReportService : consumirEvento()
    activate ReportService

    ReportService -> ResultDB : consultarResultados()
    activate ResultDB

    ResultDB --> ReportService : resultados
    deactivate ResultDB

    ReportService -> ReportDB : atualizarRelatorio()
    activate ReportDB

    ReportDB --> ReportService : relatorioAtualizado()
    deactivate ReportDB

    deactivate ReportService

else Enviar Notificações

    ResultQueue -> NotificationQueue : publicarNotificacao()

    NotificationQueue -> EmailAPI : enviarResultadoEmail()
    activate EmailAPI

    EmailAPI --> NotificationQueue : emailEnviado()
    deactivate EmailAPI

    NotificationQueue -> WhatsAppAPI : enviarResultadoWhatsApp()
    activate WhatsAppAPI

    WhatsAppAPI --> NotificationQueue : mensagemEnviada()
    deactivate WhatsAppAPI

end

ResultService --> Gateway : resultadoRegistrado()

Gateway --> Frontend : operaçãoRealizada()

Frontend --> Administrador : confirmaçãoResultado()

deactivate ResultService
deactivate Gateway
deactivate Frontend

== 7. Cancelamento de Competição ==

Administrador -> Frontend : cancelarCompeticao(competicaoID)
activate Frontend

Frontend -> Gateway : cancelarCompeticao()
activate Gateway

Gateway -> CompetitionService : cancelarCompeticao()
activate CompetitionService

CompetitionService -> CompetitionDB : buscarCompeticao()
activate CompetitionDB

CompetitionDB --> CompetitionService : dadosCompeticao
deactivate CompetitionDB

CompetitionService -> CompetitionDB : atualizarStatus(CANCELADA)
activate CompetitionDB

CompetitionDB --> CompetitionService : competicaoCancelada()
deactivate CompetitionDB

CompetitionService -> CompetitionQueue : publicarEventoCancelamento()

loop Para cada atleta inscrito

    CompetitionQueue -> NotificationQueue : publicarNotificacao()

    NotificationQueue -> EmailAPI : enviarEmailCancelamento()
    activate EmailAPI

    EmailAPI --> NotificationQueue : emailEnviado()
    deactivate EmailAPI

    NotificationQueue -> WhatsAppAPI : enviarMensagemCancelamento()
    activate WhatsAppAPI

    WhatsAppAPI --> NotificationQueue : mensagemEnviada()
    deactivate WhatsAppAPI

end

CompetitionService --> Gateway : cancelamentoRealizado()

Gateway --> Frontend : operaçãoRealizada()

Frontend --> Administrador : confirmaçãoCancelamento()

deactivate CompetitionService
deactivate Gateway
deactivate Frontend

== 8. Geração de Relatórios ==

Administrador -> Frontend : gerarRelatorioMedalhas()
activate Frontend

Frontend -> Gateway : gerarRelatorio()
activate Gateway

Gateway -> ReportService : gerarRelatorioMedalhas()
activate ReportService

ReportService -> ResultDB : buscarResultados()
activate ResultDB

ResultDB --> ReportService : dadosResultados
deactivate ResultDB

ReportService -> CountryDB : buscarPaises()
activate CountryDB

CountryDB --> ReportService : dadosPaises
deactivate CountryDB

ReportService -> ReportDB : salvarRelatorio()
activate ReportDB

ReportDB --> ReportService : relatorioGerado()
deactivate ReportDB

ReportService --> Gateway : relatorioPDF()

Gateway --> Frontend : downloadRelatorio()

Frontend --> Administrador : relatórioDisponível()

deactivate ReportService
deactivate Gateway
deactivate Frontend

@enduml