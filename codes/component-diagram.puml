@startuml

skinparam componentStyle uml2
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho

top to bottom direction

title Diagrama de Implantação - Sistema de Gestão Olímpica

node "Vercel" {

        artifact "Aplicação React" as ReactApp
}

cloud "AWS - API Gateway" {

    component "Amazon API Gateway" as ApiGateway
}

cloud "AWS - Load Balancer" {

    component "Application Load Balancer" as ALB
}

cloud "AWS - RabbitMQ" {

    node "Amazon EC2" {

        node "Docker Container - RabbitMQ" {

            component "RabbitMQ Broker" as RabbitMQ

            queue "Fila Inscrições" as RegistrationQueue
            queue "Fila Resultados" as ResultQueue
            queue "Fila Notificações" as NotificationQueue
        }
    }
}

interface "IAuth" as IAuth
interface "ICompeticoes" as ICompetitions
interface "IInscricoes" as IRegistrations
interface "IResultados" as IResults
interface "IRelatorios" as IReports
interface "ILocais" as IVenues
interface "IPaises" as ICountries

interface "ISMTP" as ISMTP
interface "IWhatsApp" as IWhatsApp

cloud "AWS ECS - Autenticação" {

    node "Docker Container - Auth" {

        component "Serviço Autenticação" as AuthService

        interface "IDBUsuarios" as IDBU

        database "Amazon RDS\nPostgreSQL Usuários" as UserDB

        AuthService -- IAuth

        AuthService --( IDBU : TCP/IP

        UserDB -- IDBU
    }
}

cloud "AWS ECS - Competições" {

    node "Docker Container - Competições" {

        component "Serviço Competições" as CompetitionService

        interface "IDBCompeticoes" as IDBC

        database "Amazon RDS\nPostgreSQL Competições" as CompetitionDB

        CompetitionService -- ICompetitions

        CompetitionService --( IDBC : TCP/IP

        CompetitionDB -- IDBC
    }
}

cloud "AWS ECS - Inscrições" {

    node "Docker Container - Inscrições" {

        component "Serviço Inscrições" as RegistrationService

        interface "IDBInscricoes" as IDBI

        database "Amazon RDS\nPostgreSQL Inscrições" as RegistrationDB

        RegistrationService -- IRegistrations

        RegistrationService --( IDBI : TCP/IP

        RegistrationDB -- IDBI
    }
}

cloud "AWS ECS - Resultados" {

    node "Docker Container - Resultados" {

        component "Serviço Resultados" as ResultService

        interface "IDBResultados" as IDBRes

        database "Amazon RDS\nPostgreSQL Resultados" as ResultDB

        ResultService -- IResults

        ResultService --( IDBRes : TCP/IP

        ResultDB -- IDBRes
    }
}

cloud "AWS ECS - Relatórios" {

    node "Docker Container - Relatórios" {

        component "Serviço Relatórios" as ReportService

        interface "IDBRelatorios" as IDBR

        database "Amazon RDS\nPostgreSQL Relatórios" as ReportDB

        ReportService -- IReports

        ReportService --( IDBR : TCP/IP

        ReportDB -- IDBR
    }
}

cloud "AWS ECS - Locais" {

    node "Docker Container - Locais" {

        component "Serviço Locais" as VenueService

        interface "IDBLocais" as IDBL

        database "Amazon RDS\nPostgreSQL Locais" as VenueDB

        VenueService -- IVenues

        VenueService --( IDBL : TCP/IP

        VenueDB -- IDBL
    }
}

cloud "AWS ECS - Países" {

    node "Docker Container - Países" {

        component "Serviço Países" as CountryService

        interface "IDBPaises" as IDBP

        database "Amazon RDS\nPostgreSQL Países" as CountryDB

        CountryService -- ICountries

        CountryService --( IDBP : TCP/IP

        CountryDB -- IDBP
    }
}

cloud "Serviço Externo - Email" {

    component "SMTP / Email API" as EmailService

    EmailService -- ISMTP
}

cloud "Serviço Externo - WhatsApp" {

    component "WhatsApp Business API" as WhatsAppService

    WhatsAppService -- IWhatsApp
}

cloud "AWS CloudWatch" {

    component "Logs e Monitoramento" as CloudWatch
}

ReactApp --> ApiGateway : HTTPS

ApiGateway --> ALB : HTTPS

ALB --( IAuth : HTTP
ALB --( ICompetitions : HTTP
ALB --( IRegistrations : HTTP
ALB --( IResults : HTTP
ALB --( IReports : HTTP
ALB --( IVenues : HTTP
ALB --( ICountries : HTTP

RegistrationService --( IAuth : REST
RegistrationService --( ICompetitions : REST

CompetitionService --( IVenues : REST

ResultService --( ICompetitions : REST
ResultService --( IAuth : REST

ReportService --( IResults : REST
ReportService --( ICountries : REST

RegistrationService --> RegistrationQueue : Evento Inscrição

ResultService --> ResultQueue : Evento Resultado

RegistrationQueue --> NotificationQueue : Publica Evento

ResultQueue --> NotificationQueue : Publica Evento

ResultQueue --> ReportService : Consumidor

NotificationQueue --( ISMTP : SMTP

NotificationQueue --( IWhatsApp : HTTPS API

AuthService --> CloudWatch
CompetitionService --> CloudWatch
RegistrationService --> CloudWatch
ResultService --> CloudWatch
ReportService --> CloudWatch
VenueService --> CloudWatch
CountryService --> CloudWatch

@enduml