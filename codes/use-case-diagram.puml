@startuml
left to right direction

skinparam packageStyle rectangle

actor Usuario
actor Atleta
actor Administrador as Admin

Usuario <|-- Atleta
Usuario <|-- Admin

rectangle "Sistema de Gestão Olímpica" {

    usecase "UC01 - Realizar login" as UC_Login
    usecase "UC02 - Recuperar senha" as UC_ResetPassword

    usecase "UC03 - Cadastrar competição" as UC_CreateCompetition
    usecase "UC04 - Consultar competições" as UC_ViewCompetitions

    usecase "UC05 - Cadastrar atleta" as UC_CreateAthlete
    usecase "UC06 - Inscrever atleta em competição" as UC_RegisterAthlete

    usecase "UC07 - Cadastrar local" as UC_CreateVenue
    usecase "UC08 - Alocar local para competição" as UC_AllocateVenue
    usecase "UC09 - Validar disponibilidade de local" as UC_ValidateVenue

    usecase "UC10 - Registrar resultado" as UC_RecordResult
    usecase "UC11 - Consultar resultados" as UC_ViewResults

    usecase "UC12 - Gerar relatório de medalhas" as UC_MedalReport
    usecase "UC13 - Gerar ranking de países" as UC_CountryRanking

    usecase "UC14 - Confirmação de inscrição" as UC_RegistrationConfirmation
}

Usuario --> UC_Login

Atleta --> UC_ViewCompetitions
Atleta --> UC_RegisterAthlete
Atleta --> UC_ViewResults

Admin --> UC_CreateCompetition
Admin --> UC_CreateAthlete
Admin --> UC_CreateVenue
Admin --> UC_AllocateVenue

Admin --> UC_RecordResult
UC_RecordResult --> Atleta

Admin --> UC_MedalReport

Admin --> UC_RegistrationConfirmation
UC_RegistrationConfirmation --> Atleta

UC_CreateCompetition ..> UC_ValidateVenue : <<include>>
UC_AllocateVenue ..> UC_ValidateVenue : <<include>>

UC_ResetPassword ..> UC_Login : <<extend>>

UC_CountryRanking ..> UC_MedalReport : <<extend>>

@enduml