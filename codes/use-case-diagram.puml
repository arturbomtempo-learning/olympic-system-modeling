@startuml
left to right direction

skinparam packageStyle rectangle

actor Usuario
actor Atleta
actor Administrador as Admin

Usuario <|-- Atleta
Usuario <|-- Admin

rectangle "Sistema de Gestão Olímpica" {

    usecase "UC01 - Realizar login" as UC_Login
    usecase "UC02 - Recuperar senha" as UC_ResetPassword

    usecase "UC03 - Gerenciar competições" as UC_ManageCompetitions
    usecase "UC04 - Consultar competições" as UC_ViewCompetitions

    usecase "UC05 - Gerenciar atletas" as UC_ManageAthletes
    usecase "UC06 - Inscrever atleta em competição" as UC_RegisterAthlete

    usecase "UC07 - Gerenciar locais" as UC_ManageVenues
    usecase "UC08 - Alocar local para competição" as UC_AllocateVenue
    usecase "UC09 - Validar disponibilidade de local" as UC_ValidateVenue

    usecase "UC10 - Gerenciar resultados" as UC_ManageResults
    usecase "UC11 - Consultar resultados" as UC_ViewResults

    usecase "UC12 - Gerar relatório de medalhas" as UC_MedalReport
    usecase "UC13 - Gerar ranking de países" as UC_CountryRanking

    usecase "UC14 - Enviar confirmação de inscrição" as UC_RegistrationNotification
    usecase "UC15 - Notificar resultados da competição" as UC_ResultNotification
}

Usuario --> UC_Login

Atleta --> UC_ViewCompetitions
Atleta --> UC_RegisterAthlete
Atleta --> UC_ViewResults

Admin --> UC_ManageCompetitions
Admin --> UC_ManageAthletes
Admin --> UC_ManageVenues
Admin --> UC_AllocateVenue
Admin --> UC_ManageResults
Admin --> UC_MedalReport

Admin --> UC_ResultNotification
UC_ResultNotification --> Atleta

Admin --> UC_RegistrationNotification
UC_RegistrationNotification --> Atleta

UC_ManageCompetitions ..> UC_ValidateVenue : <<include>>
UC_AllocateVenue ..> UC_ValidateVenue : <<include>>

UC_ResetPassword ..> UC_Login : <<extend>>

UC_CountryRanking ..> UC_MedalReport : <<extend>>

@enduml