@startuml
skinparam classAttributeIconSize 0

abstract class Usuario {
    - nome : String
    - cpf : String
    - email : String
    - senha : String

    + {abstract} Autenticar()
    + RedefinirSenha()
    + Logout()
}

class Atleta {
    - dataNascimento : Date
    - altura : double
    - peso : double

    + Cadastrar()
    + Autenticar()
}

class Administrador {
    - matricula : String
    - cargo : String
    - nivelAcesso : int

    + Cadastrar()
    + Autenticar()
}

class Competicao {
    - nomeModalidade : String
    - data : Date
    - horario : Time

    + Cadastrar()
    + ConsultarInformacoes()
    + ValidarDisponibilidadeLocal()
}

class Local {
    - nome : String
    - endereco : String
    - capacidade : int

    + Cadastrar()
    + VerificarCapacidade()
}

class Inscricao {
    - dataInscricao : Date
    - status : String

    + Inscrever()
    + ConfirmarInscricao()
    + CancelarInscricao()
}

class Resultado {
    - colocacao : int
    - pontuacao : double

    + Registrar()
    + GerarRanking()
    + GerarRelatorioMedalhas()
}

class Pais {
    - nome : String
    - sigla : String

    + Cadastrar()
}

Usuario <|-- Atleta
Usuario <|-- Administrador

Pais "1" -- "*" Atleta

Atleta "1" -- "*" Inscricao

Competicao "1" -- "*" Inscricao

Local "1" -- "*" Competicao

Competicao "1" *-- "*" Resultado

Resultado "*" -- "1" Atleta

Administrador "1" -- "*" Competicao
@enduml