@startuml

skinparam classAttributeIconSize 0

abstract class Usuario {
    - nome : String
    - cpf : String
    - email : String
    - senha : String

    + autenticar()
    + redefinirSenha()
    + logout()
}

class Atleta {
    - dataNascimento : Date
    - altura : double
    - peso : double

    + gerenciar()
}

class Administrador {
    - matricula : String
    - cargo : String
    - nivelAcesso : int

    + gerenciar()
}

class Competicao {
    - nomeModalidade : String
    - data : Date
    - horario : Time
    - status : StatusCompeticao

    + gerenciar()
    + consultarInformacoes()
}

class Local {
    - nome : String
    - endereco : String
    - capacidade : int

    + gerenciar()
    + alocar()
    + verificarCapacidade()
    + validarDisponibilidadeLocal()
}

class Inscricao {
    - dataInscricao : Date
    - status : StatusInscricao

    + inscrever()
    + confirmarInscricao()
    + cancelarInscricao()
}

class Resultado {
    - colocacao : int
    - pontuacao : double
    - medalha : TipoMedalha

    + registrar()
    + consultar()
}

class Relatorio {
    - dataGeracao : Date
    - tipo : String

    + gerarRelatorioMedalhas()
    + gerarRankingPaises()
}

class Notificacao {
    - mensagem : String
    - dataEnvio : Date

    + enviar()
}

class Pais {
    - nome : String
    - sigla : String

    + gerenciar()
}

enum StatusCompeticao {
    ATIVA
    CANCELADA
    ENCERRADA
}

enum StatusInscricao {
    CONFIRMADA
    PENDENTE
    CANCELADA
}

enum TipoMedalha {
    OURO
    PRATA
    BRONZE
    NENHUM
}

Usuario <|-- Atleta
Usuario <|-- Administrador

Pais "1" -- "*" Atleta

Atleta "1" -- "*" Inscricao

Competicao "1" -- "*" Inscricao

Local "1" -- "*" Competicao

Competicao "1" *-- "*" Resultado

Resultado "*" -- "1" Atleta

Relatorio "1" -- "*" Resultado

Atleta "1" -- "*" Notificacao
Administrador "1" -- "*" Notificacao

Administrador "1" -- "*" Competicao

@enduml